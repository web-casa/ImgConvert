{
  "name": "@imgconvert/web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0 || >=24"
  },
  "scripts": {
    "build": "vite build && node scripts/generate-pwa.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "pwa:verify": "node scripts/generate-pwa.mjs --check && node --check dist/service-worker.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@imgconvert/conversion-contract": "workspace:*",
    "@imgconvert/web-image-engine": "workspace:*",
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@lucide/svelte": "^1.22.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@zip.js/zip.js": "2.9.0",
    "gifuct-js": "2.1.2",
    "pdfjs-dist": "6.3.289",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "26.0.1",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
