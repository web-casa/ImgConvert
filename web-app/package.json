{
  "name": "@imgconvert/web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0 || >=24"
  },
  "scripts": {
    "build": "vite build && node scripts/generate-pwa.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "vite --host 0.0.0.0",
    "preview": "vite preview",
    "pwa:verify": "node scripts/generate-pwa.mjs --check && node --check dist/service-worker.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test:e2e:environment": "playwright test --config playwright.environment.config.ts"
  },
  "dependencies": {
    "@imgconvert/conversion-contract": "workspace:*",
    "@imgconvert/environmental-impact": "workspace:*",
    "@imgconvert/web-conversion-runtime": "workspace:*",
    "@imgconvert/web-image-engine": "workspace:*",
    "@lucide/svelte": "^1.22.0",
    "svelte": "^5.56.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "26.0.1",
    "svelte-check": "^4.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
