+            self.dispatch_event(mouse_up, cx);
+        } else if retry && self.a11y_scroll_into_view(node) {
+            self.on_next_frame(move |window, _| {
+                window.on_next_frame(move |window, cx| window.a11y_click(node, false, cx));
+            });
