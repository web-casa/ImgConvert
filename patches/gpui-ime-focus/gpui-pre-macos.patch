+/// `NSApplicationTerminateReply` values.
+const NS_TERMINATE_CANCEL: NSUInteger = 0;
+const NS_TERMINATE_NOW: NSUInteger = 1;
+/// `kAEQuitReason` ('why?'): present on the quit Apple Event when the
+/// session ends (log out, restart, shut down).
+const AE_QUIT_REASON: u32 = 0x7768_793f;
+
+extern "C" fn should_terminate(this: &mut Object, _: Sel, _: id) -> NSUInteger {
+    let platform = unsafe { get_mac_platform(this) };
+    let mut lock = platform.0.lock();
+    let Some(mut callback) = lock.should_terminate.take() else {
+        return NS_TERMINATE_NOW;
+    };
+    drop(lock);
+    let reason = if unsafe { session_is_ending() } {
+        TerminateReason::SessionEnd
+    } else {
+        TerminateReason::UserQuit
+    };
+    let reply = callback(reason);
+    platform.0.lock().should_terminate.get_or_insert(callback);
+    match reply {
+        TerminateReply::Now => NS_TERMINATE_NOW,
+        TerminateReply::Cancel => NS_TERMINATE_CANCEL,
+    }
+}
+
+/// Whether the Apple Event being handled is a quit with a session-end
+/// reason.
+unsafe fn session_is_ending() -> bool {
+    unsafe {
+        let manager: id = msg_send![class!(NSAppleEventManager), sharedAppleEventManager];
+        let event: id = msg_send![manager, currentAppleEvent];
+        if event == nil {
+            return false;
+        }
+        let reason: id = msg_send![event, attributeDescriptorForKeyword: AE_QUIT_REASON];
+        if reason == nil {
+            return false;
+        }
+        let code: u32 = msg_send![reason, enumCodeValue];
+        code != 0
+    }
+}
