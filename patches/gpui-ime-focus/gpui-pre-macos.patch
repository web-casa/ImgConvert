+    fn discard_marked_text(&self) {
+        let (view, closed) = {
+            let state = self.0.lock();
+            if state.closed.load(Ordering::SeqCst) {
+                return;
+            }
+            // Native callbacks can close the window. Keep its client alive
+            // without holding the state mutex across any AppKit callback.
+            (
+                unsafe { objc::rc::StrongPtr::retain(state.native_view.as_ptr()) },
+                Arc::clone(&state.closed),
+            )
+        };
+        unsafe {
+            let context: id = msg_send![*view, inputContext];
+            if context.is_null() {
+                return;
+            }
+            let context = objc::rc::StrongPtr::retain(context);
+            let active: id = msg_send![class!(NSTextInputContext), currentInputContext];
+            let _: () = msg_send![*context, discardMarkedText];
+            if closed.load(Ordering::SeqCst) || active != *context {
+                return;
+            }
+            let active: id = msg_send![class!(NSTextInputContext), currentInputContext];
+            if !active.is_null() && active != *context {
+                return;
+            }
+            // Pinyin can retain its popup after discard alone when focus moves
+            // via AXPress rather than a native mouse event. End that active
+            // session before installing the next framework input handler.
+            let _: () = msg_send![*context, deactivate];
+            if closed.load(Ordering::SeqCst) {
+                return;
+            }
+            let window: id = msg_send![*view, window];
+            if window.is_null() {
+                return;
+            }
+            let key: BOOL = msg_send![window, isKeyWindow];
+            let responder: id = msg_send![window, firstResponder];
+            let active: id = msg_send![class!(NSTextInputContext), currentInputContext];
+            // Reentrant native callbacks may have activated another window.
+            // Never activate this client over another active input context.
+            if key == YES && responder == *view && (active.is_null() || active == *context) {
+                let _: () = msg_send![*context, activate];
+            }
+        }
+    }
