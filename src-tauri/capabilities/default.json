{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "os:allow-locale",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/web-casa/ImgConvert/issues" }]
    },
    "dialog:allow-open",
    "dialog:allow-message",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "fs:scope",
    "process:allow-restart"
  ]
}
