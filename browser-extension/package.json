{
  "name": "@imgconvert/browser-extension",
  "private": true,
  "version": "0.3.4",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13.0 || >=24"
  },
  "scripts": {
    "build": "pnpm run runtime:build && pnpm run build:chrome:only && pnpm run build:edge:only",
    "build:chrome": "pnpm run runtime:build && pnpm run build:chrome:only",
    "build:chrome:only": "wxt build -b chrome",
    "build:diagnostics:chrome": "pnpm run runtime:build && node scripts/build-diagnostics.mjs --browser=chrome",
    "build:diagnostics:edge": "pnpm run runtime:build && node scripts/build-diagnostics.mjs --browser=edge",
    "build:edge": "pnpm run runtime:build && pnpm run build:edge:only",
    "build:edge:only": "wxt build -b edge",
    "bundle:report": "pnpm run guardrails",
    "check": "pnpm run runtime:build && pnpm run typecheck:only && pnpm run test && pnpm run lint && pnpm run format:check && pnpm run build:chrome:only && pnpm run build:edge:only && pnpm run guardrails",
    "dev": "wxt -b chrome",
    "dev:edge": "wxt -b edge",
    "format:check": "prettier --check .",
    "guardrails": "node scripts/check-build.mjs --browser=chrome && node scripts/check-build.mjs --browser=edge",
    "lint": "eslint .",
    "prepare": "wxt prepare",
    "runtime:build": "pnpm --dir ../packages/environmental-impact build && pnpm --dir ../packages/conversion-contract build && pnpm --dir ../packages/web-image-engine build && pnpm --dir ../packages/web-conversion-runtime build",
    "smoke:chrome": "pnpm run build:diagnostics:chrome && node scripts/smoke-unpacked.mjs --browser=chrome --runtime",
    "smoke:chrome:offline": "pnpm run build:diagnostics:chrome && node scripts/smoke-unpacked.mjs --browser=chrome --runtime --offline",
    "smoke:chrome:update": "node scripts/smoke-update.mjs --browser=chrome",
    "smoke:edge": "pnpm run build:diagnostics:edge && node scripts/smoke-unpacked.mjs --browser=edge --runtime",
    "smoke:edge:offline": "pnpm run build:diagnostics:edge && node scripts/smoke-unpacked.mjs --browser=edge --runtime --offline",
    "smoke:edge:update": "node scripts/smoke-update.mjs --browser=edge",
    "smoke:minimum:chromium": "pnpm run build:diagnostics:chrome && node scripts/smoke-unpacked.mjs --browser=chrome --expected-product=chromium --expected-major=116 --offline --runtime --accessibility --resource --report=.output/reports/chromium-116-smoke.json",
    "smoke:vendor:chrome": "pnpm run build:diagnostics:chrome && node scripts/smoke-unpacked.mjs --browser=chrome --expected-product=chrome --offline --runtime --accessibility --resource --report=.output/reports/chrome-vendor-smoke.json",
    "smoke:vendor:edge": "pnpm run build:diagnostics:edge && node scripts/smoke-unpacked.mjs --browser=edge --expected-product=edge --offline --runtime --accessibility --resource --report=.output/reports/edge-vendor-smoke.json",
    "smoke:web-import:chrome": "node scripts/smoke-unpacked.mjs --browser=chrome --expected-product=chrome --web-import --report=.output/reports/chrome-web-import-allow.json",
    "smoke:web-import:chrome:deny": "node scripts/smoke-unpacked.mjs --browser=chrome --expected-product=chrome --deny-web-import --report=.output/reports/chrome-web-import-deny.json",
    "smoke:web-import:edge": "node scripts/smoke-unpacked.mjs --browser=edge --expected-product=edge --web-import --report=.output/reports/edge-web-import-allow.json",
    "smoke:web-import:edge:deny": "node scripts/smoke-unpacked.mjs --browser=edge --expected-product=edge --deny-web-import --report=.output/reports/edge-web-import-deny.json",
    "store:assets:graphics": "node scripts/render-store-assets.mjs --mode=graphics",
    "store:assets:screenshots": "node scripts/render-store-assets.mjs --mode=screenshots",
    "store:audit": "node scripts/audit-production-dependencies.mjs",
    "store:candidate": "node scripts/create-store-candidate.mjs",
    "store:check": "pnpm run zip:check && node scripts/check-store-draft.mjs",
    "store:finalize": "node scripts/finalize-store-candidate.mjs",
    "store:privacy:verify": "node scripts/verify-privacy-deployment.mjs",
    "store:prepare": "node scripts/prepare-store-draft.mjs",
    "test": "vitest run && pnpm run test:release",
    "test:release": "node --test scripts/release-evidence.test.mjs",
    "typecheck": "pnpm run runtime:build && pnpm run typecheck:only",
    "typecheck:only": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "zip": "pnpm run zip:chrome && pnpm run zip:edge && pnpm run zip:check",
    "zip:check": "node scripts/check-zip.mjs --browser=chrome && node scripts/check-zip.mjs --browser=edge",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "smoke:native:chrome": "node scripts/smoke-unpacked.mjs --browser=chrome --native-side-panel --offline --report=.output/reports/chromium-native-side-panel.json",
    "smoke:environment:chrome": "node scripts/smoke-unpacked.mjs --browser=chrome --environment --offline --report=.output/reports/chrome-environment.json",
    "smoke:environment:edge": "node scripts/smoke-unpacked.mjs --browser=edge --environment --offline --report=.output/reports/edge-environment.json"
  },
  "dependencies": {
    "@imgconvert/conversion-contract": "workspace:*",
    "@imgconvert/web-conversion-runtime": "workspace:*",
    "@imgconvert/web-image-engine": "workspace:*",
    "@imgconvert/environmental-impact": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.61.1",
    "@types/node": "26.0.1",
    "@wxt-dev/module-svelte": "2.0.5",
    "eslint": "9.39.4",
    "prettier": "3.9.4",
    "svelte": "5.56.4",
    "svelte-check": "4.7.1",
    "typescript": "6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wxt": "0.21.4"
  }
}
