# Preserve pinned license text hashes and generated attribution bytes on Windows.
/apps/gpui/THIRD_PARTY_LICENSES.md text eol=lf
/apps/gpui/licenses/** text eol=lf
# Bundled policy documents have the same bytes on every desktop platform.
/PRIVACY.md text eol=lf
/PRIVACY.en.md text eol=lf
# PDF xref offsets require byte-identical test fixtures.
/apps/gpui/crates/shell/tests/fixtures/*.pdf binary
/apps/gpui/crates/shell/tests/fixtures/*.png binary
